{
  "name": "wiggle-gpl",
  "private": true,
  "version": "0.1.1",
  "license": "GPL-3.0-only",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "postinstall": "node scripts/copy-ffmpeg.mjs",
    "copy:ffmpeg": "node scripts/copy-ffmpeg.mjs",
    "build": "node scripts/copy-ffmpeg.mjs && tsc && vite build",
    "test": "node --test test/*.test.mjs",
    "preview": "vite preview",
    "perf:project": "node scripts/perf-project.mjs",
    "electron:dev": "VITE_DEV_URL=http://localhost:5173 electron .",
    "electron:build": "npm run build && electron-builder --mac",
    "electron:release": "npm run build && electron-builder --mac --publish always"
  },
  "devDependencies": {
    "electron": "^32.3.3",
    "electron-builder": "^25.1.8",
    "playwright": "^1.60.0",
    "typescript": "^5.4.0",
    "vite": "^6.4.3"
  },
  "dependencies": {
    "@ffmpeg/core": "0.12.6",
    "@ffmpeg/ffmpeg": "0.12.15",
    "@ffmpeg/util": "0.12.2",
    "electron-updater": "^6.8.9"
  },
  "build": {
    "appId": "com.wigglegpl.app",
    "productName": "Wiggle GPL",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.graphics-design",
      "icon": "build/wiggle-gpl.icns"
    },
    "publish": [{
      "provider": "github",
      "owner": "its-jovee",
      "repo": "wiggle-gpl",
      "releaseType": "release"
    }],
    "directories": {
      "buildResources": "build",
      "output": "release"
    }
  }
}
